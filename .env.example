# Copy to .env and fill in real values. Used by docker compose only.
DB_USER=senabayu
DB_PASSWORD=change-me
DB_NAME=senabayu
DB_PORT=5432
# At least 32 characters. Signs admin login tokens.
JWT_SIGNING_KEY=change-me-to-at-least-32-random-characters
# The admin login created when the database is first seeded.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
